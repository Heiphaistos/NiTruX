{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NiTruX",
  "version": "0.8.0",
  "identifier": "org.heiphaistos.nitrux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NiTruX",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Heiphaistos",
    "homepage": "https://github.com/Heiphaistos/NiTruX",
    "shortDescription": "Couteau suisse de maintenance et diagnostic pour Linux",
    "longDescription": "NiTruX est un outil tout-en-un de maintenance, diagnostic et administration système pour Linux : informations matérielles en temps réel, gestion des paquets multi-distro, pilotes et modules noyau, journaux système, et un moteur de thèmes/dispositions personnalisable.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.packages.policy": "packaging/org.heiphaistos.nitrux.packages.policy",
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.network.policy": "packaging/org.heiphaistos.nitrux.network.policy",
          "/usr/bin/nitrux-pkexec-install-package": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-upgrade-all": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-write-hosts": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-set-dns": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-firewall-rule": "packaging/nitrux-pkexec-helper",
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.security.policy": "packaging/org.heiphaistos.nitrux.security.policy",
          "/usr/bin/nitrux-pkexec-troubleshoot": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-create-snapshot": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-quarantine-file": "packaging/nitrux-pkexec-helper",
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.disks.policy": "packaging/org.heiphaistos.nitrux.disks.policy",
          "/usr/bin/nitrux-pkexec-format-partition": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-extend-partition": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-clone-disk": "packaging/nitrux-pkexec-helper"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.packages.policy": "packaging/org.heiphaistos.nitrux.packages.policy",
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.network.policy": "packaging/org.heiphaistos.nitrux.network.policy",
          "/usr/bin/nitrux-pkexec-install-package": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-upgrade-all": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-write-hosts": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-set-dns": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-firewall-rule": "packaging/nitrux-pkexec-helper",
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.security.policy": "packaging/org.heiphaistos.nitrux.security.policy",
          "/usr/bin/nitrux-pkexec-troubleshoot": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-create-snapshot": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-quarantine-file": "packaging/nitrux-pkexec-helper",
          "/usr/share/polkit-1/actions/org.heiphaistos.nitrux.disks.policy": "packaging/org.heiphaistos.nitrux.disks.policy",
          "/usr/bin/nitrux-pkexec-format-partition": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-extend-partition": "packaging/nitrux-pkexec-helper",
          "/usr/bin/nitrux-pkexec-clone-disk": "packaging/nitrux-pkexec-helper"
        }
      }
    }
  }
}
