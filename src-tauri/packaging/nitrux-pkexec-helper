    # timeshift's own confirmation prompt to attach to; without it the
    # process would just hang until the caller's own timeout killed it.
    exec timeshift --delete --snapshot "$name" --yes
    ;;
  quarantine-file)
    path="${2:-}"
    validate_quarantine_path "$path"
    if [ ! -e "$path" ]; then
      die "quarantine target does not exist: $path"
    fi
    mkdir -p /var/lib/nitrux/quarantine
    chmod 700 /var/lib/nitrux/quarantine
    dest="/var/lib/nitrux/quarantine/$(date +%s)-$(basename "$path")"
    mv "$path" "$dest"
    chmod 000 "$dest"
    echo "quarantined: $dest"
    ;;
  format-partition)
    device="${2:-}"
    fstype="${3:-}"
    validate_partition_device "$device"
    validate_partition_not_in_use "$device"
    validate_fstype "$fstype"
    case "$fstype" in
      ext4)  exec mkfs.ext4 -F "$device" ;;
      btrfs) exec mkfs.btrfs -f "$device" ;;
      xfs)   exec mkfs.xfs -f "$device" ;;
      vfat)  exec mkfs.vfat -F 32 "$device" ;;
    esac
    ;;
  extend-partition)
    device="${2:-}"
    disk="${3:-}"
    partnum="${4:-}"
    validate_partition_device "$device"
    validate_partition_not_in_use "$device"
    validate_disk_device "$disk"
    case "$partnum" in
      ''|*[!0-9]*) die "partition number must be numeric: $partnum" ;;
    esac
    parted --script "$disk" resizepart "$partnum" 100%
    exec resize2fs "$device"
    ;;
  clone-disk)
    source_disk="${2:-}"
    dest_path="${3:-}"
    validate_disk_device "$source_disk"
    validate_image_dest_path "$dest_path"
    # dest_path sits in a directory the invoking (unprivileged) user already
    # controls (e.g. their own $HOME) -- a process racing the polkit auth
    # prompt could pre-position a symlink there so this root-privileged dd
    # follows it and overwrites an arbitrary file elsewhere (verified: dd
    # writes through an existing symlink to its target, not the link
    # itself). noclobber makes `exec 3>` refuse anything already at that
    # path -- symlink or regular file alike -- and a failed exec redirect
    # aborts a non-interactive POSIX shell immediately, before chmod/dd run
    # (both verified). Writing dd's output through the resulting fd, never
    # re-resolving dest_path by name, also survives an attacker unlinking
    # and re-symlinking the path in the instant right after this create
    # succeeds (verified) -- closes the TOCTOU race entirely, not just
    # narrows it.
    set -C
    exec 3>"$dest_path"
    chmod 600 /proc/self/fd/3
    dd if="$source_disk" of=/proc/self/fd/3 bs=4M status=progress conv=fsync
    ;;
  write-iso)
    image="${2:-}"
    disk="${3:-}"
    validate_image_source_path "$image"
    validate_disk_device "$disk"
    # A bootable USB stick only: an ISO written to an internal disk by a
    # wrong pick in a list is the mistake this check exists for.
    [ "$(lsblk -dno TRAN "$disk" 2>/dev/null)" = "usb" ] || die "not a USB disk: $disk"
    validate_disk_not_in_use "$disk"
    write_image_to_disk "$image" "$disk"
    ;;
  restore-image)
    image="${2:-}"
    disk="${3:-}"
    validate_image_source_path "$image"
    validate_disk_device "$disk"
    validate_disk_not_in_use "$disk"
    write_image_to_disk "$image" "$disk"
    ;;
  partition-create)
    disk="${2:-}"
    size="${3:-}"
    validate_disk_device "$disk"
    case "$size" in ''|*[!0-9]*) die "size must be a number of MiB (0 = all the free space): $size" ;; esac
    command -v parted >/dev/null 2>&1 || die "parted is not installed"
    # parted reports a filesystem written on the whole disk as a "loop"
    # label: that disk holds data, it is not free space (seen on a VM).
    label=$(parted -m -s "$disk" print 2>/dev/null | sed -n 2p | cut -d: -f6)
    if [ -z "$label" ] || [ "$label" = "unknown" ]; then
      # No partition table. Only a truly blank disk gets one: a disk with a
      # filesystem or RAID signature written straight on it is not "empty".
      [ -z "$(blkid -p -o value -s TYPE "$disk" 2>/dev/null)" ] || die "$disk has no partition table but holds data ($(blkid -p -o value -s TYPE "$disk")); refusing"
      parted -s "$disk" mklabel gpt
    elif [ "$label" = "loop" ]; then
      die "$disk holds a filesystem directly, without a partition table ($(blkid -p -o value -s TYPE "$disk")); refusing"
    fi
    # Largest free region, rounded inward to whole MiB (parted prints
    # fractions like 0.02MiB, which mkpart rejects; whole MiB also aligns).
    region=$(parted -m -s "$disk" unit MiB print free | awk -F: '/free;$/ {
        gsub("MiB","",$2); gsub("MiB","",$3)
        s=int($2); if (s < $2) s++; if (s < 1) s=1
        # An end on an exact MiB is the end of the disk, where GPT keeps
        # its backup header: stop one MiB short of it.
        e=int($3); if (e == $3) e--
        if (e-s > best) {best=e-s; r=s" "e}
      } END {print r}')
    [ -n "$region" ] || die "no free space on $disk"
    start=$(echo "$region" | cut -d' ' -f1)
    end=$(echo "$region" | cut -d' ' -f2)
    if [ "$size" -gt 0 ]; then
      wanted=$(awk -v s="$start" -v n="$size" 'BEGIN {print s+n}')
      awk -v w="$wanted" -v e="$end" 'BEGIN {exit !(w <= e)}' || die "only $(awk -v s="$start" -v e="$end" 'BEGIN {printf "%d", e-s}') MiB free on $disk"
      end="$wanted"
    fi
    parted -s -a optimal "$disk" mkpart primary "${start}MiB" "${end}MiB"
