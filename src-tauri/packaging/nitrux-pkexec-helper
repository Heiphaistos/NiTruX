    resize2fs "$device"
    e2fsck -f -n "$device"
    echo "shrunk: $device to ${size} MiB"
    ;;
  inventory)
    # Read-only hardware and security inventory for the "Scan PC" and
    # hardware pages: fixed commands only, nothing is written or changed.
    what="${2:-}"
    export LC_ALL=C
    case "$what" in
      dmi-memory)
        command -v dmidecode >/dev/null 2>&1 || die "dmidecode is not installed"
        exec dmidecode -t 16 -t 17
        ;;
      dmi-system)
        command -v dmidecode >/dev/null 2>&1 || die "dmidecode is not installed"
        exec dmidecode -t 0 -t 1 -t 2 -t 3 -t 4
        ;;
      smart)
        dev="${3:-}"
        case "$dev" in
          /dev/sd[a-z]|/dev/sd[a-z][a-z]|/dev/nvme[0-9]|/dev/nvme[0-9]n[0-9]|/dev/hd[a-z]|/dev/vd[a-z]|/dev/mmcblk[0-9]) : ;;
          *) die "invalid disk device: $dev" ;;
        esac
        command -v smartctl >/dev/null 2>&1 || die "smartctl is not installed"
        # smartctl uses its exit status as a bit field (bit 6 = errors in
        # the log...): the report itself is what matters, not the status.
        smartctl -a "$dev" || true
        exit 0
        ;;
      grub-entries)
        # Top-level menu entries, in GRUB's own numbering (0 = first).
        for cfg in /boot/grub/grub.cfg /boot/grub2/grub.cfg; do
          [ -r "$cfg" ] && exec awk -F"'" '/^menuentry /{print n++ "\t" $2} /^submenu /{print n++ "\t" $2 " (sous-menu)"}' "$cfg"
        done
        die "grub.cfg not found"
        ;;
      snapper-list)
        command -v snapper >/dev/null 2>&1 || die "snapper is not installed"
        exec snapper --csvout -c root list --columns number,date,description
        ;;
      firmware-key)
        # OEM Windows licence key embedded in the ACPI MSDM table (the key
        # is the last 29 bytes). Empty output: no such key on this machine.
        table=/sys/firmware/acpi/tables/MSDM
        if [ -r "$table" ]; then tail -c 29 "$table"; echo; fi
        exit 0
        ;;
      security-audit)
        echo "### sshd"
        if command -v sshd >/dev/null 2>&1; then
          sshd -T 2>/dev/null | grep -Ei '^(permitrootlogin|passwordauthentication|permitemptypasswords|port|pubkeyauthentication) ' || true
        fi
        echo "### empty-passwords"
        awk -F: '($2==""){print $1}' /etc/shadow 2>/dev/null || true
        echo "### uid0"
        awk -F: '($3==0){print $1}' /etc/passwd
        echo "### sudo-nopasswd"
        grep -rhE '^[^#]*NOPASSWD' /etc/sudoers /etc/sudoers.d 2>/dev/null || true
        echo "### suid-unusual"
        find / -xdev -perm -4000 -type f \( -path '/home/*' -o -path '/tmp/*' -o -path '/var/tmp/*' -o -path '/dev/shm/*' -o -path '/opt/*' \) 2>/dev/null | head -n 50
        echo "### world-writable-etc"
        find /etc -xdev -type f -perm -0002 2>/dev/null | head -n 50
        echo "### root-crontab"
        crontab -l -u root 2>/dev/null | grep -v '^#' || true
        echo "### root-secrets"
        find /root -maxdepth 4 -type f \( -name 'id_rsa' -o -name 'id_ecdsa' -o -name 'id_ed25519' -o -name '*.pem' -o -name '*.key' -o -name '.env' -o -name 'credentials' -o -name '.netrc' -o -name '.pgpass' \) 2>/dev/null | head -n 50
        echo "### end"
        exit 0
        ;;
      *) die "unknown inventory item: $what" ;;
    esac
    ;;
  *)
    die "unknown subcommand: $cmd"
    ;;
esac
