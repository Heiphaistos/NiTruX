  partition-delete)
    device="${2:-}"
    validate_partition_device "$device"
    validate_partition_free "$device"
    disk=$(partition_parent "$device")
    number=$(partition_number "$device")
    parted -s "$disk" rm "$number"
    partprobe "$disk" 2>/dev/null || true
    echo "deleted: $device"
