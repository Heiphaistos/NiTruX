      # queries no link-specific server claims.
      printf '[Resolve]\nDNS=%s\nDomains=~.\n' "$servers" > /etc/systemd/resolved.conf.d/nitrux-dns.conf
      exec systemctl restart systemd-resolved
    elif systemctl is-active --quiet NetworkManager 2>/dev/null && [ -L /etc/resolv.conf ]; then
      rm -f /etc/resolv.conf.nitrux-tmp
      mkdir -p /etc/NetworkManager/conf.d
      printf '[global-dns-domain-*]\nservers=%s\n' "$(echo $servers | tr ' ' ',')" > /etc/NetworkManager/conf.d/nitrux-dns.conf
      exec nmcli general reload
    fi
    mv /etc/resolv.conf.nitrux-tmp /etc/resolv.conf
    ;;
  firewall-rule)
    action="${2:-}"
    portproto="${3:-}"
