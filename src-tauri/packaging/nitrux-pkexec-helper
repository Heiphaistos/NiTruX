#!/bin/sh
# src-tauri/packaging/nitrux-pkexec-helper
#
# The ONLY program pkexec is ever invoked against for NiTruX's privileged
# write operations (see org.heiphaistos.nitrux.packages.policy and
# org.heiphaistos.nitrux.network.policy). This script is installed
# setuid-safe via pkexec (runs as root once polkit authorizes it) and is
# the last line of defense against malformed or malicious arguments —
# Rust-side validation happens too, but this script NEVER trusts that and
# re-validates everything itself.
#
# This same script is installed under 14 distinct names (one per polkit
# action): nitrux-pkexec-install-package, nitrux-pkexec-uninstall-package,
# nitrux-pkexec-upgrade-all, nitrux-pkexec-install-snap,
# nitrux-pkexec-write-hosts,
# nitrux-pkexec-set-dns, nitrux-pkexec-firewall-rule,
# nitrux-pkexec-troubleshoot, nitrux-pkexec-create-snapshot,
# nitrux-pkexec-quarantine-file, nitrux-pkexec-format-partition,
# nitrux-pkexec-extend-partition, nitrux-pkexec-clone-disk,
# nitrux-pkexec-system-tools. pkexec
# resolves which action to authorize by matching the *executable path*
# against each action's exec.path annotation -- it cannot see argv, so a
# single shared path across multiple actions is ambiguous to it (confirmed
# live: pkexec authorized under the wrong action when actions shared one
# path). Giving each action its own on-disk copy under its own name
# removes the ambiguity. The dispatch logic below is unchanged -- it still
# reads the subcommand from argv[1], regardless of which name it was
# invoked under.
#
# Usage:
#   nitrux-pkexec-install-package install-package <manager> <package>
#   nitrux-pkexec-uninstall-package uninstall-package <manager> <package>
#   nitrux-pkexec-upgrade-all upgrade-all
#   nitrux-pkexec-install-snap install-snap <package>
#   nitrux-pkexec-write-hosts write-hosts               (base64 content on stdin)
#   nitrux-pkexec-set-dns set-dns                       (base64 content on stdin)
#   nitrux-pkexec-firewall-rule firewall-rule <add|remove> <port/proto>
#   nitrux-pkexec-troubleshoot troubleshoot <clean-cache|fix-broken|restart-network|vacuum-logs>
#   nitrux-pkexec-create-snapshot create-snapshot
#   nitrux-pkexec-quarantine-file quarantine-file <absolute-path>
#   nitrux-pkexec-format-partition format-partition <device> <ext4|btrfs|xfs|vfat>
#   nitrux-pkexec-extend-partition extend-partition <partition-device> <disk-device> <partnum>
#   nitrux-pkexec-clone-disk clone-disk <disk-device> <dest-image-path>
#   nitrux-pkexec-system-tools system-tool <apt-autoremove|journal-vacuum-size|rebuild-ld-cache|systemd-reload|fstrim-all|rebuild-locate-db|regenerate-grub>
set -eu

die() {
  echo "nitrux-pkexec-helper: $1" >&2
  exit 1
}

# Package names: conservative allowlist covering every real package name
# character used by apt/dnf/pacman/zypper (alphanumeric, dot, dash, plus,
# colon for epoch/arch qualifiers like "pkg:amd64"). Rejects anything with
# shell metacharacters, spaces, or path separators outright.
validate_package_name() {
  case "$1" in
    '') die "empty package name" ;;
    *[!a-zA-Z0-9.+:_-]*) die "package name contains disallowed characters: $1" ;;
  esac
}

validate_manager() {
  case "$1" in
    apt|dnf|pacman|zypper) : ;;
    *) die "unknown package manager: $1" ;;
  esac
}

# DNS servers and hosts-file content arrive as base64-encoded stdin, not
# argv, to avoid any shell-argv-length limits and to sidestep argv-based
# injection concerns entirely for multi-line content -- the helper decodes
# and writes verbatim, with NO shell interpretation of the decoded bytes
# at any point (base64 decode -> direct file write, never through a shell).
validate_port_proto() {
  # e.g. "22/tcp", "80/tcp", "53/udp" -- matches ufw's own rule syntax.
  case "$1" in
    [0-9]*/tcp|[0-9]*/udp) : ;;
    *) die "invalid port/protocol format (expected e.g. 22/tcp): $1" ;;
  esac
  # The glob above accepts any digit string, with no 1-65535 bound -- same
  # gap already fixed on the Rust side (network_write.rs, upstream of
  # every real call into this script) but never mirrored here. Reject
  # anything 10+ digits long BEFORE the arithmetic comparison below: that
  # keeps the operand always well within any POSIX shell's native integer
  # range, so `[ "$port" -lt 1 ]`/`-gt 65535` can never itself error out on
  # an oversized literal. Verified live (2026-08-08, unprivileged, this
  # function only, never reaching ufw): old glob-only check wrongly
  # accepted "0/tcp", "99999999/tcp", "65536/tcp"; this rejects all three
  # while still accepting "65535/tcp", "1/tcp", and a leading-zero port.
  port="${1%%/*}"
  case "$port" in
    ??????????*) die "port number too long: $1" ;;
  esac
  if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    die "port out of range 1-65535: $1"
  fi
}

validate_troubleshoot_action() {
  case "$1" in
    clean-cache|fix-broken|restart-network|vacuum-logs) : ;;
    *) die "unknown troubleshoot action: $1" ;;
  esac
}

# Quarantine only ever accepts an ABSOLUTE path with no ".." traversal
# component and no shell metacharacters -- this runs as root and moves
# whatever it's given, so the validation here is the only thing standing
# between a caller and moving an arbitrary root-owned file.
validate_quarantine_path() {
  case "$1" in
    '') die "empty quarantine path" ;;
    /*) : ;;
    *) die "quarantine path must be absolute: $1" ;;
  esac
  # Reject the filesystem root itself ("/", "//", "///", ...): every check
  # above passes it (absolute, no "..", no metacharacters), and this is a
  # "quarantine one file" feature with no legitimate reason to ever target
  # the root -- confirmed live (2026-08-06, unprivileged, this function
  # only, never reaching mv) that `basename "/"` prints "/" too, so the
  # dest below would become ".../<timestamp>-/" and `mv "$1" "$dest"`
  # would attempt to move the entire mounted root as root. Strip trailing
  # slashes (POSIX has no extglob for a one-shot "one or more" match) and
  # check whether anything meaningful is left.
  stripped="$1"
  while [ "${stripped%/}" != "$stripped" ]; do
    stripped="${stripped%/}"
  done
  if [ -z "$stripped" ]; then
    die "cannot quarantine the filesystem root: $1"
  fi
  case "$1" in
    *..*) die "quarantine path must not contain '..': $1" ;;
    *'*'*|*'?'*|*'$'*|*'`'*|*';'*|*'|'*|*'&'*|*'<'*|*'>'*|*'\n'*)
      die "quarantine path contains disallowed characters: $1" ;;
  esac
}

# A partition device path must look like "<disk><number>" or an NVMe
# "<nvme-disk>p<number>" -- this is what distinguishes a PARTITION from a
# WHOLE DISK. Formatting a whole disk (e.g. /dev/sda) destroys the
# partition table, not just one filesystem's data -- almost never what is
# intended, and far more destructive than formatting one partition.
#
# NOTE on the case pattern below: `[0-9]*` matches one digit followed by
# ANY trailing characters -- it is NOT anchored to the end of the string,
# so e.g. "/dev/sda1;rm -rf /" technically matches this case arm (verified
# empirically). This is safe in practice ONLY because of two other layers,
# not because the pattern itself is a strict allowlist:
#   1. The `-b` check below requires a REAL, EXISTING block device node at
#      that exact literal path. An attacker cannot make one exist at an
#      arbitrary path of their choosing without already having the root
#      privileges this script exists to gate.
#   2. Every call site below passes $device through `exec cmd "$device"`
#      with quoted argv -- never through a shell (`sh -c`, `eval`, etc.) --
#      so even a real device node with shell metacharacters in its path
#      could never have those characters reinterpreted as shell syntax.
# Do not remove or weaken either of those two layers on the assumption
# that this case pattern alone is sufficient input validation.
validate_partition_device() {
  case "$1" in
    /dev/sd[a-z][0-9]*|/dev/vd[a-z][0-9]*|/dev/nvme[0-9]*n[0-9]*p[0-9]*|/dev/mmcblk[0-9]*p[0-9]*|/dev/loop[0-9]*p[0-9]*) : ;;
    *) die "not a recognized partition device path (expected e.g. /dev/sda1, /dev/nvme0n1p1): $1" ;;
  esac
  if [ ! -b "$1" ]; then
    die "not a block device: $1"
  fi
}

# Refuses to touch a device that is currently mounted, OR that is (or
# backs) the currently-booted root filesystem -- checked independently of
# the mount check as defense in depth. This operation is irreversible, so
# the extra check costs nothing and only helps.
validate_partition_not_in_use() {
  if findmnt -n -S "$1" >/dev/null 2>&1; then
    die "device is currently mounted, refusing: $1"
  fi
  root_device=$(findmnt -n -o SOURCE / 2>/dev/null || echo "")
  if [ -n "$root_device" ] && [ "$1" = "$root_device" ]; then
    die "refusing to touch the currently-booted root device: $1"
  fi
}

validate_disk_device() {
  case "$1" in
    /dev/sd[a-z]|/dev/vd[a-z]|/dev/nvme[0-9]*n[0-9]*|/dev/mmcblk[0-9]*|/dev/loop[0-9]*) : ;;
    *) die "not a recognized whole-disk device path: $1" ;;
  esac
  if [ ! -b "$1" ]; then
    die "not a block device: $1"
  fi
}

validate_fstype() {
  case "$1" in
    ext4|btrfs|xfs|vfat) : ;;
    *) die "unsupported filesystem type (expected ext4, btrfs, xfs, or vfat): $1" ;;
  esac
}

# Destination image path for clone-disk: absolute, no traversal, no shell
# metacharacters -- same style as validate_quarantine_path in the security
# actions, since this also runs as root and writes wherever it's told.
validate_image_dest_path() {
  case "$1" in
    '') die "empty destination path" ;;
    /*) : ;;
    *) die "destination path must be absolute: $1" ;;
  esac
  case "$1" in
    *..*) die "destination path must not contain '..': $1" ;;
    *'*'*|*'?'*|*'$'*|*'`'*|*';'*|*'|'*|*'&'*|*'<'*|*'>'*|*'\n'*)
      die "destination path contains disallowed characters: $1" ;;
  esac
}

cmd="${1:-}"

case "$cmd" in
  install-package)
    manager="${2:-}"
    package="${3:-}"
    validate_manager "$manager"
    validate_package_name "$package"
    case "$manager" in
      apt)    exec apt-get install -y --no-install-recommends "$package" ;;
      dnf)    exec dnf install -y "$package" ;;
      pacman) exec pacman -S --noconfirm "$package" ;;
      zypper) exec zypper --non-interactive install "$package" ;;
    esac
    ;;
  install-snap)
    package="${2:-}"
    validate_package_name "$package"
    exec snap install "$package"
    ;;
  system-tool)
    action="${2:-}"
    case "$action" in
      apt-autoremove)
        # Confirmed live (2026-08-06, isolated reproduction with a fake
        # apt-get standing in via PATH, never the real one): with the
        # naive `if cmd; then ...; fi` sequence below, on any system with
        # only ONE of these three managers (the normal case -- this is
        # the target distro's own apt on Debian), the LAST `if` in the
        # chain tests a manager that ISN'T installed, and `if false; then
        # ...; fi` with no `else` exits 0 by POSIX definition -- so the
        # script's real exit code was ALWAYS 0 (success) regardless of
        # whether the one manager that DID run actually succeeded or
        # failed. A real `apt-get autoremove` failure was silently
        # reported as success to the user 100% of the time. Capture the
        # actual exit code of whichever manager(s) actually ran instead.
        status=0
        if command -v apt-get >/dev/null 2>&1; then apt-get autoremove -y || status=$?; fi
        if command -v dnf >/dev/null 2>&1; then dnf autoremove -y || status=$?; fi
        if command -v zypper >/dev/null 2>&1; then zypper --non-interactive remove --clean-deps || status=$?; fi
        exit "$status"
        ;;
      journal-vacuum-size)
        exec journalctl --vacuum-size=200M
        ;;
      rebuild-ld-cache)
        exec ldconfig
        ;;
      systemd-reload)
        exec systemctl daemon-reload
        ;;
      fstrim-all)
        exec fstrim -av
        ;;
      rebuild-locate-db)
        if command -v updatedb >/dev/null 2>&1; then exec updatedb; fi
        echo "updatedb non installé" >&2
        exit 1
        ;;
      regenerate-grub)
        if command -v update-grub >/dev/null 2>&1; then exec update-grub; fi
        if command -v grub2-mkconfig >/dev/null 2>&1; then exec grub2-mkconfig -o /boot/grub2/grub.cfg; fi
        echo "aucun générateur de configuration GRUB trouvé" >&2
        exit 1
        ;;
      *)
        die "unknown system-tool action: $action"
        ;;
    esac
    ;;
  uninstall-package)
    manager="${2:-}"
    package="${3:-}"
    validate_manager "$manager"
    validate_package_name "$package"
    case "$manager" in
      apt)    exec apt-get remove -y "$package" ;;
      dnf)    exec dnf remove -y "$package" ;;
      pacman) exec pacman -R --noconfirm "$package" ;;
      zypper) exec zypper --non-interactive remove "$package" ;;
    esac
    ;;
  upgrade-all)
    # Runs whichever managers are actually present; a manager not
    # installed on this host is silently skipped, not an error — same
    # philosophy as packages::detect_package_managers() on the read side.
    if command -v apt-get >/dev/null 2>&1; then
      apt-get update -y
      apt-get upgrade -y
    fi
    if command -v dnf >/dev/null 2>&1; then
      dnf upgrade -y
    fi
    if command -v pacman >/dev/null 2>&1; then
      pacman -Syu --noconfirm
    fi
    if command -v zypper >/dev/null 2>&1; then
      zypper --non-interactive update
    fi
    ;;
  write-hosts)
    # Content arrives base64-encoded on stdin to avoid argv length limits
    # and multi-line/quoting issues entirely. Decoded bytes are written
    # directly to the target file -- never passed through a shell.
    base64 -d > /etc/hosts.nitrux-tmp
    # Sanity check: refuse to install an empty or suspiciously tiny result
    # (a truncated/failed decode could otherwise wipe /etc/hosts to
    # near-nothing, breaking basic name resolution like "localhost").
    size=$(wc -c < /etc/hosts.nitrux-tmp)
    if [ "$size" -lt 10 ]; then
      rm -f /etc/hosts.nitrux-tmp
      die "decoded hosts content suspiciously small ($size bytes), refusing to write"
    fi
    mv /etc/hosts.nitrux-tmp /etc/hosts
    ;;
  set-dns)
    base64 -d > /etc/resolv.conf.nitrux-tmp
    size=$(wc -c < /etc/resolv.conf.nitrux-tmp)
    if [ "$size" -lt 5 ]; then
      rm -f /etc/resolv.conf.nitrux-tmp
      die "decoded resolv.conf content suspiciously small ($size bytes), refusing to write"
    fi
    mv /etc/resolv.conf.nitrux-tmp /etc/resolv.conf
    ;;
  firewall-rule)
    action="${2:-}"
    portproto="${3:-}"
    validate_port_proto "$portproto"
    case "$action" in
      add)    exec ufw allow "$portproto" ;;
      remove) exec ufw delete allow "$portproto" ;;
      *)      die "unknown firewall action: $action (expected add or remove)" ;;
    esac
    ;;
  troubleshoot)
    action="${2:-}"
    validate_troubleshoot_action "$action"
    case "$action" in
      clean-cache)
        if command -v apt-get >/dev/null 2>&1; then apt-get clean; fi
        if command -v dnf >/dev/null 2>&1; then dnf clean all; fi
        if command -v pacman >/dev/null 2>&1; then pacman -Scc --noconfirm; fi
        if command -v zypper >/dev/null 2>&1; then zypper clean --all; fi
        ;;
      fix-broken)
        if command -v apt-get >/dev/null 2>&1; then
          dpkg --configure -a
          apt-get install -f -y
        elif command -v zypper >/dev/null 2>&1; then
          zypper verify -y
        else
          echo "no repair step defined for the detected package manager on this system" >&2
        fi
        ;;
      restart-network)
        exec systemctl restart NetworkManager
        ;;
      vacuum-logs)
        exec journalctl --vacuum-time=7d
        ;;
    esac
    ;;
  create-snapshot)
    exec timeshift --create --comments "NiTruX manual snapshot"
    ;;
  quarantine-file)
    path="${2:-}"
    validate_quarantine_path "$path"
    if [ ! -e "$path" ]; then
      die "quarantine target does not exist: $path"
    fi
    mkdir -p /var/lib/nitrux/quarantine
    chmod 700 /var/lib/nitrux/quarantine
    dest="/var/lib/nitrux/quarantine/$(date +%s)-$(basename "$path")"
    mv "$path" "$dest"
    chmod 000 "$dest"
    echo "quarantined: $dest"
    ;;
  format-partition)
    device="${2:-}"
    fstype="${3:-}"
    validate_partition_device "$device"
    validate_partition_not_in_use "$device"
    validate_fstype "$fstype"
    case "$fstype" in
      ext4)  exec mkfs.ext4 -F "$device" ;;
      btrfs) exec mkfs.btrfs -f "$device" ;;
      xfs)   exec mkfs.xfs -f "$device" ;;
      vfat)  exec mkfs.vfat -F 32 "$device" ;;
    esac
    ;;
  extend-partition)
    device="${2:-}"
    disk="${3:-}"
    partnum="${4:-}"
    validate_partition_device "$device"
    validate_partition_not_in_use "$device"
    validate_disk_device "$disk"
    case "$partnum" in
      ''|*[!0-9]*) die "partition number must be numeric: $partnum" ;;
    esac
    parted --script "$disk" resizepart "$partnum" 100%
    exec resize2fs "$device"
    ;;
  clone-disk)
    source_disk="${2:-}"
    dest_path="${3:-}"
    validate_disk_device "$source_disk"
    validate_image_dest_path "$dest_path"
    # dest_path sits in a directory the invoking (unprivileged) user already
    # controls (e.g. their own $HOME) -- a process racing the polkit auth
    # prompt could pre-position a symlink there so this root-privileged dd
    # follows it and overwrites an arbitrary file elsewhere (verified: dd
    # writes through an existing symlink to its target, not the link
    # itself). noclobber makes `exec 3>` refuse anything already at that
    # path -- symlink or regular file alike -- and a failed exec redirect
    # aborts a non-interactive POSIX shell immediately, before chmod/dd run
    # (both verified). Writing dd's output through the resulting fd, never
    # re-resolving dest_path by name, also survives an attacker unlinking
    # and re-symlinking the path in the instant right after this create
    # succeeds (verified) -- closes the TOCTOU race entirely, not just
    # narrows it.
    set -C
    exec 3>"$dest_path"
    chmod 600 /proc/self/fd/3
    dd if="$source_disk" of=/proc/self/fd/3 bs=4M status=progress conv=fsync
    ;;
  *)
    die "unknown subcommand: $cmd"
    ;;
esac
