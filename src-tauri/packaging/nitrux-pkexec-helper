  delete-snapshot)
    name="${2:-}"
    validate_snapshot_name "$name"
    if command -v snapper >/dev/null 2>&1 && snapper --csvout list-configs 2>/dev/null | grep -q '^root,'; then
      case "$name" in
        *[!0-9]*) die "snapper snapshot numbers are digits only: $name" ;;
        0) die "snapshot 0 is the running system, refusing" ;;
      esac
