      # Read-only: `ufw status` refuses to run unprivileged, so listing the
      # rules needs the same authorization as changing them. Takes no
      # further argument; the C locale keeps the output parseable.
      status) exec env LC_ALL=C ufw status ;;
      # --force skips ufw's interactive "may disrupt ssh" y/n prompt, which
      # would otherwise hang with no terminal; the page warns instead.
      enable)  exec ufw --force enable ;;
      disable) exec ufw disable ;;
      add)    validate_port_proto "$portproto"; exec ufw allow "$portproto" ;;
      remove) validate_port_proto "$portproto"; exec ufw delete allow "$portproto" ;;
      *)      die "unknown firewall action: $action (expected status, enable, disable, add or remove)" ;;
    esac
    ;;
  troubleshoot)
    action="${2:-}"
    validate_troubleshoot_action "$action"
    case "$action" in
      clean-cache)
        if command -v apt-get >/dev/null 2>&1; then apt-get clean; fi
        if command -v dnf >/dev/null 2>&1; then dnf clean all; fi
        if command -v pacman >/dev/null 2>&1; then pacman -Scc --noconfirm; fi
        if command -v zypper >/dev/null 2>&1; then zypper clean --all; fi
        ;;
      fix-broken)
        if command -v apt-get >/dev/null 2>&1; then
          dpkg --configure -a
          apt-get install -f -y
        elif command -v zypper >/dev/null 2>&1; then
          zypper verify -y
        else
          echo "no repair step defined for the detected package manager on this system" >&2
        fi
        ;;
      restart-network)
        exec systemctl restart NetworkManager
        ;;
      vacuum-logs)
        exec journalctl --vacuum-time=7d
        ;;
    esac
    ;;
  create-snapshot)
    # Snapper when it manages / (Omarchy, openSUSE, Fedora on btrfs), the
    # same test the app uses to pick the backend; Timeshift otherwise.
    if command -v snapper >/dev/null 2>&1 && snapper --csvout list-configs 2>/dev/null | grep -q '^root,'; then
      exec snapper -c root create -c number -d "NiTruX manual snapshot"
    fi
    exec timeshift --create --comments "NiTruX manual snapshot"
    ;;
  restore-snapshot-file)
    # One file back to its state in Snapper snapshot N (undochange N..0:
    # undo what changed since N, for this path only). The current version is
    # kept next to it first, as <file>.avant-restauration.
    name="${2:-}"
    path="${3:-}"
    case "$name" in ''|*[!0-9]*|0) die "snapper snapshot numbers are positive digits only: $name" ;; esac
    validate_quarantine_path "$path"
    command -v snapper >/dev/null 2>&1 && snapper --csvout list-configs 2>/dev/null | grep -q '^root,' || die "file restore needs Snapper managing / (root config)"
    if [ -e "$path" ] && [ ! -d "$path" ]; then
      # An explicit test: noclobber (set -C) only guards shell redirections,
      # cp would silently overwrite an earlier safety copy (seen on a VM).
      [ ! -e "$path.avant-restauration" ] && [ ! -L "$path.avant-restauration" ] || die "$path.avant-restauration already exists (an earlier restore): move it away first"
      cp -a -- "$path" "$path.avant-restauration"
    fi
    exec snapper -c root undochange "$name..0" "$path"
